# SalesPilot AI Environment Configuration
# Copy this file to .env and fill in optional LLM provider keys if desired.
# The system works 100% deterministically without any API keys!

# Database URL (defaults to local SQLite)
DATABASE_URL=sqlite:///./salespilot.db

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=25

# Optional AI Provider Configuration ("deterministic", "openai", or "gemini")
AI_PROVIDER=deterministic

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
